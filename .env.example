# Copy to .env (never commit it). Real environment variables win over this file.
PORT=8080
APP_ORIGIN=http://localhost:8080
DATA_DIR=.data
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# local-mock = host-run persona picker, no network. pf = Bearer PingFederate access tokens, verified against its JWKS.
IDP=local-mock
# Vertical pack: generic (default, the original demo) or utility (utility / NERC CIP-style, invented groups, mock backends).
# PACK=generic
# Host-run only, the literal 1. Also needs IDP=local-mock and a loopback HOST. Production refuses to start with it.
# Dana (admin) additionally needs the switch file: touch .data/ALLOW_ADMIN_PERSONA
# HOST=127.0.0.1
# APPROVAL_TTL_MS=600000
ALLOW_MOCK_SIGNIN=1

# IDP=pf only
PF_URL=
PF_AUDIENCE=
# PF_ISSUER=      (defaults to PF_URL)
# PF_JWKS_URL=    (defaults to PF_URL/pf/JWKS)
# CLOCK_SKEW_SEC=30   (capped at 60)
