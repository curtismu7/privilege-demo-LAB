  "steps": [
    {
      "title": "The tool is pinned",
      "what": "At onboarding the server's tool schema is hashed and the hash is pinned. The pin is the approved baseline.",
      "edges": []
    },
    {
      "title": "The description drifts",
      "what": "The tool server changes its description (a rug pull). The tool's name and the call look the same.",
      "edges": [
        0
      ]
    },
    {
      "title": "The hash is compared",
      "what": "On the next call the enforcement point hashes what the server advertises now and hands both hashes to Cedar.",
      "edges": [
        1,
        2,
        3
      ]
    },
    {
      "title": "Policy denies it",
      "what": "s05-rugpull-pin forbids a mismatch, with no approver, so no one can wave it through. Reset restores the schema.",
      "edges": [
        4
      ]
    }
  ]
